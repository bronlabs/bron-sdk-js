{
  "name": "@bronlabs/bron-sdk",
  "version": "0.1.33",
  "description": "TypeScript SDK for the Bron API",
  "keywords": [
    "sdk",
    "bron",
    "api",
    "typescript"
  ],
  "author": "Bron Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bronlabs/bron-js-sdk.git"
  },
  "main": "dist/client.js",
  "type": "module",
  "module": "dist/client.js",
  "types": "dist/client.d.ts",
  "exports": {
    ".": {
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./types/*": {
      "import": "./dist/types/*.js",
      "require": "./dist/types/*.js",
      "types": "./dist/types/*.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./utils/*": {
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    }
  },
  "scripts": {
    "update-version": "node scripts/update-version.js",
    "build": "pnpm run update-version && tsc",
    "test": "vitest run",
    "lint": "biome check .",
    "lint-fix": "biome check --write .",
    "generate-keys": "pnpm run build && node dist/utils/keyGenerator.js",
    "build:generator": "tsc src/utils/generator.ts --ignoreConfig --types node --outDir dist/utils --module NodeNext --target ES2024 --skipLibCheck",
    "generate": "rm -rf dist && pnpm run build:generator && node dist/utils/generator.js && biome lint --write --unsafe --only=correctness/noUnusedImports src/types src/api && biome check --write src/types src/api && pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/node": "^26.6.2",
    "cuid": "^3.0.0",
    "dotenv": "^17.3.1",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
